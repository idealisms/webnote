{
  "displayName": "Webnote",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Workspace page loads",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_page_loads\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 0,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Saves, by status",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_saves\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"status\""
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 16,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "5xx responses, by status",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_5xx\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"status\""
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 16,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Failed saves (transaction)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_failed_saves\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 32,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Client JS errors, by webnote.js version",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_js_errors\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"version\""
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 32,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "RSS feed requests, by status",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_rss\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"status\""
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 48,
        "width": 48,
        "height": 16,
        "widget": {
          "title": "Saves and polls, by client version and host (empty client = before the handshake)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_clients\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"client\"",
                        "metric.label.\"host\""
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 64,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "RSS feed cache hit rate (hits / (hits + misses))",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilterRatio": {
                    "numerator": {
                      "filter": "metric.type=\"logging.googleapis.com/user/webnote_feed_cache_lookups\" resource.type=\"gae_app\" metric.label.\"result\"=\"hit\"",
                      "aggregation": {
                        "alignmentPeriod": "3600s",
                        "perSeriesAligner": "ALIGN_SUM",
                        "crossSeriesReducer": "REDUCE_SUM"
                      }
                    },
                    "denominator": {
                      "filter": "metric.type=\"logging.googleapis.com/user/webnote_feed_cache_lookups\" resource.type=\"gae_app\" metric.label.\"result\"=one_of(\"hit\",\"miss\")",
                      "aggregation": {
                        "alignmentPeriod": "3600s",
                        "perSeriesAligner": "ALIGN_SUM",
                        "crossSeriesReducer": "REDUCE_SUM"
                      }
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "hit rate",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 64,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "RSS feed cache size (bytes, hourly p99; limit 32 MiB)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "minAlignmentPeriod": "3600s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/webnote_feed_cache_bytes\" resource.type=\"gae_app\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MAX"
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "bytes",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 80,
        "width": 48,
        "height": 8,
        "widget": {
          "title": "More",
          "text": {
            "format": "MARKDOWN",
            "content": "Per hour. Counts start when the metrics were created.\n\n- Error groups: [Error Reporting](https://console.cloud.google.com/errors?project=webnote-184120)\n- Active workspaces: the Log Analytics query in `tools/metrics/README.md`"
          }
        }
      }
    ]
  }
}
