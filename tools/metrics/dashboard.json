                        "metric.label.\"status\""
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "per hour",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 16,
        "width": 24,
        "height": 16,
        "widget": {
